# Copy to .env.local and fill in to enable accounts + cross-device sync.
# Without these values RemCraft runs fully offline (IndexedDB only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Base path the app is served from (GitHub Pages project sites use "/<repo>/").
VITE_BASE_PATH=/
